generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  pedidos   Pedido[]

  @@map("users")
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  stock       Int
  createdAt   DateTime @default(now())
  pedidos     Pedido[]

  @@map("productos")
}

model Pedido {
  id        Int          @id @default(autoincrement())
  cantidad  Int
  estado    EstadoPedido @default(PENDIENTE)
  createdAt DateTime     @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  @@map("pedidos")
}
